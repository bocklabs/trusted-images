{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":configMigration"
  ],
  "automerge": false,
  "automergeType": "pr",
  "automergeStrategy": "merge",
  "platformAutomerge": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Inventory upstream ref/tag/digest tracking.",
      "managerFilePatterns": [
        "/^inventory\\/[^/]+\\/image\\.yaml$/"
      ],
      "matchStrings": [
        "ref:\\s*(?<depName>[^\\s]+)\\n\\s*tag:\\s*['\\\"]?(?<currentValue>[^'\\\"\\s]+)['\\\"]?\\n\\s*digest:\\s*['\\\"]?(?<currentDigest>sha256:[a-f0-9]{64})['\\\"]?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "autoReplaceStringTemplate": "ref: {{{depName}}}\n    tag: {{{newValue}}}\n    digest: {{{newDigest}}}"
    },
    {
      "customType": "regex",
      "description": "SecObserve vYYYY_MM tags need custom digest lookup.",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "uses:\\s+SecObserve/secobserve_actions_templates/(?<actionPath>[^@\\s]+)@(?<currentDigest>[a-f0-9]{40})\\s+#\\s+(?<currentValue>v\\d{4}_\\d{2})"
      ],
      "depNameTemplate": "SecObserve/secobserve_actions_templates",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "regex:^v?(?<major>\\d{4})_(?<minor>\\d{2})$",
      "autoReplaceStringTemplate": "uses: SecObserve/secobserve_actions_templates/{{{actionPath}}}@{{{newDigest}}} # {{{newValue}}}"
    },
    {
      "customType": "regex",
      "description": "Digest-pinned tool images in workflows and scripts.",
      "managerFilePatterns": [
        "\\.github/workflows/[^/]+\\.yaml$",
        "^scripts/[^/]+\\.py$"
      ],
      "matchStrings": [
        "(?:[\"']|^)(?<depName>(?:[a-z0-9.-]+/)*[a-z0-9._-]+/[a-z0-9._-]+):(?<currentValue>[a-zA-Z0-9._-]+)@(?<currentDigest>sha256:[a-f0-9]{64})(?:[\"']|$)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Cosign CLI release used by signing; validation reads this pin.",
      "managerFilePatterns": [
        "/^\\.github/workflows/promote-publish\\.yaml$/"
      ],
      "matchStrings": [
        "cosign-release: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "sigstore/cosign",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Trivy CLI release used by the Trivy action.",
      "managerFilePatterns": [
        "/^\\.github/workflows/promote-candidate\\.yaml$/"
      ],
      "matchStrings": [
        "uses: aquasecurity/trivy-action@[a-f0-9]{40}[^\\n]*\\n        env:\\n(?:          [^\\n]+\\n)+        with:\\n          version: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "aquasecurity/trivy",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Inventory images receive stable major and minor releases only.",
      "matchFileNames": ["inventory/**/image.yaml"],
      "matchUpdateTypes": ["patch", "digest", "pin", "pinDigest"],
      "enabled": false
    },
    {
      "description": "Automerge Cosign action and CLI pins through required validation.",
      "matchPackageNames": ["sigstore/cosign-installer", "sigstore/cosign"],
      "matchFileNames": [".github/workflows/promote-publish.yaml", ".github/workflows/validate.yaml"],
      "automerge": true
    },
    {
      "description": "Automerge Trivy action and CLI pins through required validation.",
      "matchPackageNames": ["aquasecurity/trivy-action", "aquasecurity/trivy"],
      "matchFileNames": [".github/workflows/promote-candidate.yaml"],
      "automerge": true
    },
    {
      "description": "Hold the deliberately stale nginx qualification pin until its patch qualification is reviewed.",
      "matchFileNames": [
        "inventory/nginx-qualification/image.yaml"
      ],
      "automerge": false
    },
    {
      "description": "Disable Renovate's native GitHub Actions handling for SecObserve. SecObserve vYYYY_MM releases are managed by the custom regex manager so SHA pinning can be retained without native digest lookup failures.",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "SecObserve/secobserve_actions_templates"
      ],
      "enabled": false
    }
  ]
}
